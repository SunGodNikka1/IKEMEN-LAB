<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>IKEMENLab.Mcp.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\IKEMENLab.Mcp\IKEMENLab.Mcp.csproj" />
    <ProjectReference Include="..\IKEMENLab.Core\IKEMENLab.Core.csproj" />
    <ProjectReference Include="..\IKEMENLab.Mcp.Tests.StdinEngine\IKEMENLab.Mcp.Tests.StdinEngine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The MCP tests replay the Core tests' mock-engine traces against the same ComboGuy fixture character -->
    <Compile Include="..\IKEMENLab.Tests\XRayFixtures.cs" Link="Shared\XRayFixtures.cs" />
    <Compile Include="..\IKEMENLab.Tests\SffTestBuilder.cs" Link="Shared\SffTestBuilder.cs" />
    <Compile Include="..\IKEMENLab.Tests\BehaviorTraces.cs" Link="Shared\BehaviorTraces.cs" />
    <None Include="..\IKEMENLab.Tests\Fixtures\xray_driver_mock_seq_*.jsonl" Link="Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
