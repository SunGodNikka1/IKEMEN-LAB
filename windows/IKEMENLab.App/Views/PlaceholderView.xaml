<UserControl x:Class="IKEMENLab.App.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="28" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="560">
        <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>
        <TextBlock Text="{Binding Message}" Margin="0,12,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextMutedBrush}"/>
    </StackPanel>
</UserControl>
