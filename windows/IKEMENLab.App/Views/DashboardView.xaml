<UserControl x:Class="IKEMENLab.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock Text="Dashboard" FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding RootPath}" Margin="0,8,0,20"
                       Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>

            <UniformGrid Columns="3" Margin="0,0,0,8">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Characters" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding CharacterCount}" FontSize="32" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0">
                            <Run Text="{Binding NestedCount, Mode=OneWay}"/>
                            <Run Text=" nested"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Stages" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding StageCount}" FontSize="32" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}" BorderBrush="{DynamicResource AccentBrush}">
                    <StackPanel>
                        <TextBlock Text="Launch Game" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="Ikemen_GO.exe" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,8,0,12"/>
                        <Button Content="Launch Game"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding LaunchCommand}"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0"
                       Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
