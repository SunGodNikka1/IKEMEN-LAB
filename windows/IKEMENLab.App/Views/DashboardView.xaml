<UserControl x:Class="IKEMENLab.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:IKEMENLab.App.ViewModels">
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Root" Margin="32,28,32,32">

            <!-- ============ Header ============ -->
            <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Manage your local IKEMEN GO assets and configuration"
                       Style="{StaticResource PageSubtitle}" Margin="0,8,0,0"/>

            <!-- ============ Stat cards ============ -->
            <UniformGrid x:Name="CardsGrid" Columns="4" Margin="-8,24,-8,0">
                <Button Style="{StaticResource CardButton}" Margin="8" Command="{Binding OpenCharactersCommand}"
                        ToolTip="Browse characters" AutomationProperties.Name="Active Fighters">
                    <StackPanel>
                        <Border Style="{StaticResource IconTile}" CornerRadius="4" HorizontalAlignment="Left"
                                Background="{DynamicResource SelectedBackgroundBrush}">
                            <TextBlock Text="{StaticResource Glyph.Characters}" FontFamily="{StaticResource IconFont}"
                                       FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding CharacterCount}" Style="{StaticResource StatValue}" FontSize="24" Margin="0,16,0,0"/>
                        <TextBlock Text="Active Fighters" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource CardButton}" Margin="8" Command="{Binding OpenStagesCommand}"
                        ToolTip="Browse stages" AutomationProperties.Name="Installed Stages">
                    <StackPanel>
                        <Border Style="{StaticResource IconTile}" CornerRadius="4" HorizontalAlignment="Left"
                                Background="{DynamicResource SelectedBackgroundBrush}">
                            <TextBlock Text="{StaticResource Glyph.Stages}" FontFamily="{StaticResource IconFont}"
                                       FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding StageCount}" Style="{StaticResource StatValue}" FontSize="24" Margin="0,16,0,0"/>
                        <TextBlock Text="Installed Stages" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource HoverCard}" Margin="8" ToolTip="{Binding StorageToolTip}">
                    <StackPanel>
                        <Border Style="{StaticResource IconTile}" CornerRadius="4" HorizontalAlignment="Left"
                                Background="{DynamicResource SelectedBackgroundBrush}">
                            <TextBlock Text="{StaticResource Glyph.Drive}" FontFamily="{StaticResource IconFont}"
                                       FontSize="14" Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding StorageText}" Style="{StaticResource StatValue}" FontSize="24" Margin="0,16,0,0"/>
                        <TextBlock Text="Storage Used" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource CardButton}" Margin="8" Command="{Binding LaunchCommand}"
                        ToolTip="Start Ikemen_GO.exe from the selected installation" AutomationProperties.Name="Launch Game">
                    <StackPanel>
                        <Border Width="32" Height="32" CornerRadius="4" HorizontalAlignment="Left"
                                Background="{DynamicResource BorderStrong}" BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="White" Opacity="0.15"/>
                            </Border.Effect>
                            <TextBlock Text="{StaticResource Glyph.Play}" FontFamily="{StaticResource IconFont}"
                                       FontSize="14" Foreground="{DynamicResource TextPrimary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Launch Game" FontSize="16" FontWeight="Medium" Margin="0,24,0,0"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{Binding LaunchSubtitle}" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- ============ Two columns ============ -->
            <Grid x:Name="Columns" Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftCol" Width="*"/>
                    <ColumnDefinition x:Name="GapCol" Width="24"/>
                    <ColumnDefinition x:Name="RightCol" Width="300"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="StackGapRow" Height="0"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Left column -->
                <StackPanel x:Name="LeftPanel" Grid.Column="0">
                    <TextBlock Text="INSTALL CONTENT" Style="{StaticResource SectionLabel}" FontFamily="{StaticResource CaptionFont}"/>

                    <Grid x:Name="DropZone" Height="170" Margin="0,12,0,0" AllowDrop="True" Background="Transparent"
                          Cursor="Hand"
                          DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave" Drop="DropZone_Drop"
                          MouseLeftButtonUp="DropZone_Click"
                          ToolTip="Drop archives/folders or click to browse. Preview before install.">
                        <Border x:Name="DropFill" CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}"/>
                        <Rectangle x:Name="DropStroke" RadiusX="12" RadiusY="12" StrokeThickness="1.5" StrokeDashArray="5 4"
                                   Stroke="{DynamicResource BorderActive}" SnapsToDevicePixels="True"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Center"
                                    Background="{DynamicResource SelectedBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                <TextBlock Text="&#xEBD3;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                           Foreground="{DynamicResource TextSecondary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Install Content" HorizontalAlignment="Center" Margin="0,12,0,0"
                                       FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0"
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="420"
                                       Text="Drag and drop .zip, .rar, .7z or folders — or click to browse archives."/>
                            <Button Content="Browse folder…" Margin="0,10,0,0" HorizontalAlignment="Center"
                                    Style="{StaticResource LinkButton}"
                                    Command="{Binding BrowseInstallFolderCommand}"
                                    Click="BrowseFolder_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Honest drop feedback -->
                    <Border Margin="0,10,0,0" CornerRadius="8" Padding="12,8"
                            Background="{DynamicResource InfoBackgroundBrush}"
                            Visibility="{Binding DropNotice, Converter={StaticResource HasValueToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostIconButton}" Width="22" Height="22"
                                    FontSize="10" Content="{StaticResource Glyph.Close}" Command="{Binding DismissDropNoticeCommand}"/>
                            <TextBlock Text="{Binding DropNotice}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource InfoHoverBrush}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="RECENTLY INSTALLED" Style="{StaticResource SectionLabel}"
                               FontFamily="{StaticResource CaptionFont}" Margin="0,24,0,0"/>

                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,12,0,0" MinHeight="200">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
                                <Grid Margin="20,0,16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Name" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Type" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="Date" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="Status" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                               ToolTip="Enable or disable in select.def (same as Characters / Stages)"/>
                                </Grid>
                            </Border>

                            <TextBlock Grid.Row="1" Text="No recent installations" Style="{StaticResource BodyText}"
                                       Foreground="{DynamicResource TextTertiary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40"
                                       Visibility="{Binding HasRecentItems, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding RecentItems}" Focusable="False"
                                          x:Name="RecentItemsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:RecentItemViewModel}">
                                        <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
                                            <!-- Toggle sits outside the row Button so it cannot fire OpenRecentCommand. -->
                                            <Grid Height="72">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="44"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Style="{StaticResource RowButton}" ToolTip="{Binding ToolTip}"
                                                        Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Grid Margin="20,0,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="110"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="40" Height="40" CornerRadius="6" ClipToBounds="True"
                                                                Background="{DynamicResource SelectedBackgroundBrush}"
                                                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                                            <Grid>
                                                                <TextBlock Text="{Binding Initial}" FontSize="14" FontWeight="Medium"
                                                                           Foreground="{DynamicResource TextTertiary}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Visibility="{Binding Thumbnail, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}"/>
                                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource TextPrimary}"/>
                                                            <TextBlock Text="{Binding Author}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource TextTertiary}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <Border x:Name="TypeBadge" Grid.Column="2" HorizontalAlignment="Left" Height="24"
                                                                CornerRadius="12" Padding="9,0" BorderThickness="1"
                                                                Background="{DynamicResource BadgeCharacterBackgroundBrush}"
                                                                BorderBrush="#4D3B82F6">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Ellipse x:Name="TypeDot" Width="6" Height="6" Fill="{DynamicResource BadgeCharacterBrush}"/>
                                                                <TextBlock x:Name="TypeText" Text="{Binding TypeLabel}" Margin="6,0,0,0"
                                                                           FontSize="12" FontWeight="Medium"
                                                                           Foreground="{DynamicResource BadgeCharacterBrush}"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock Grid.Column="3" Text="{Binding DateText}" FontSize="13"
                                                                   Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Button>
                                                <Border Grid.Column="1" Background="Transparent" ToolTip="{Binding StatusToolTip}"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,16,0"
                                                        ToolTipService.ShowOnDisabled="True">
                                                    <CheckBox Style="{StaticResource InteractiveStatusToggle}"
                                                              IsChecked="{Binding IsEnabledInRoster, Mode=OneWay}"
                                                              IsEnabled="{Binding CanToggleStatus}"
                                                              Command="{Binding DataContext.ToggleRecentStatusCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              CommandParameter="{Binding}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsCharacter}" Value="False">
                                                <Setter TargetName="TypeBadge" Property="Background" Value="{DynamicResource BadgeStageBackgroundBrush}"/>
                                                <Setter TargetName="TypeBadge" Property="BorderBrush" Value="#4D8B5CF6"/>
                                                <Setter TargetName="TypeDot" Property="Fill" Value="{DynamicResource BadgeStageBrush}"/>
                                                <Setter TargetName="TypeText" Property="Foreground" Value="{DynamicResource BadgeStageBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Right column -->
                <StackPanel x:Name="RightPanel" Grid.Column="2">
                    <TextBlock Text="QUICK SETTINGS" Style="{StaticResource SectionLabel}" FontFamily="{StaticResource CaptionFont}"/>
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="Transparent" ToolTipService.ShowOnDisabled="True"
                                        ToolTip="Writes Video.VSync in save/config.ini">
                                    <CheckBox Style="{StaticResource ToggleSwitch}"
                                              IsEnabled="{Binding CanEditVSync}"
                                              IsChecked="{Binding VSync, Mode=TwoWay}"/>
                                </Border>
                                <TextBlock Text="V-Sync" FontSize="14" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </DockPanel>
                            <DockPanel Margin="0,16,0,0">
                                <Border DockPanel.Dock="Right" Background="Transparent"
                                        ToolTip="Writes Video.Fullscreen in save/config.ini">
                                    <CheckBox Style="{StaticResource ToggleSwitch}"
                                              IsEnabled="{Binding CanEditFullscreen}"
                                              IsChecked="{Binding Fullscreen, Mode=TwoWay}"/>
                                </Border>
                                <TextBlock Text="Fullscreen" FontSize="14" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </DockPanel>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Master Volume" FontSize="14" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <Border Grid.Column="1" Background="Transparent" Margin="12,0,8,0"
                                        ToolTip="Writes Sound.MasterVolume (0–100) in save/config.ini">
                                    <Slider x:Name="MasterVolumeSlider" Style="{StaticResource FlatSlider}" Minimum="0" Maximum="100"
                                            IsEnabled="{Binding CanEditMasterVolume}"
                                            Value="{Binding MasterVolume, Mode=TwoWay}" VerticalAlignment="Center"
                                            PreviewMouseUp="MasterVolumeSlider_PreviewMouseUp"
                                            LostMouseCapture="MasterVolumeSlider_LostMouseCapture"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding MasterVolumeText}" FontSize="12"
                                           FontFamily="{StaticResource CaptionFont}" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondary}"/>
                            </Grid>
                            <TextBlock Text="{Binding QuickSettingsNote}" Margin="0,14,0,0" FontSize="11"
                                       Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="CONTENT HEALTH" Style="{StaticResource SectionLabel}"
                               FontFamily="{StaticResource CaptionFont}" Margin="0,24,0,0"/>
                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid Margin="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Width="50" Height="50" VerticalAlignment="Center">
                                    <Border Width="44" Height="44" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                            Background="{DynamicResource SelectedBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                        <TextBlock Text="&#xEA18;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="HealthBadge" MinWidth="20" Height="20" CornerRadius="10" Padding="4,0"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Visibility="{Binding HealthIssueCount, Converter={StaticResource HasValueToVis}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HealthState}" Value="Errors">
                                                        <Setter Property="Background" Value="{DynamicResource NegativeBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding HealthIssueCount}" FontSize="11" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="Content Validator" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                                    <Button x:Name="HealthStatusButton" Style="{StaticResource LinkButton}" Margin="0,2,0,0"
                                            HorizontalAlignment="Left" Command="{Binding ToggleHealthDetailsCommand}">
                                        <TextBlock x:Name="HealthStatus" Text="{Binding HealthStatusText}" FontSize="12"
                                                   FontFamily="{StaticResource CaptionFont}" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HealthState}" Value="Clean">
                                                            <Setter Property="Foreground" Value="{DynamicResource PositiveBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HealthState}" Value="Warnings">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HealthState}" Value="Errors">
                                                            <Setter Property="Foreground" Value="{DynamicResource NegativeBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                </StackPanel>

                                <Button Grid.Column="2" Content="Scan" Style="{StaticResource SecondaryButton}"
                                        VerticalAlignment="Center" Command="{Binding ScanCommand}"
                                        ToolTip="Read-only scan: nothing is fixed or rewritten"/>
                            </Grid>

                            <!-- Details -->
                            <Border Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="0,0,12,12"
                                    Visibility="{Binding HealthExpanded, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <Border Style="{StaticResource HorizontalDivider}" Margin="16,0"/>
                                    <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" Margin="16,12,8,12">
                                        <ItemsControl ItemsSource="{Binding HealthGroups}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:HealthGroupViewModel}">
                                                    <StackPanel Margin="0,0,8,12" ToolTip="{Binding Path}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding TypeGlyph}" FontFamily="{StaticResource IconFont}"
                                                                       FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}" FontSize="13" Margin="8,0,8,0"
                                                                       Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"
                                                                       MaxWidth="170" VerticalAlignment="Center"/>
                                                            <Border CornerRadius="3" Padding="4,1" VerticalAlignment="Center"
                                                                    Background="{DynamicResource SelectedBackgroundBrush}">
                                                                <TextBlock Text="{Binding TypeLabel}" FontSize="9"
                                                                           FontFamily="{StaticResource CaptionFont}"
                                                                           Foreground="{DynamicResource TextTertiary}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <ItemsControl ItemsSource="{Binding Issues}" Margin="0,6,0,0" Focusable="False">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type vm:HealthIssueViewModel}">
                                                                    <Grid Margin="0,2,0,4">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="20"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock x:Name="SevIcon" Text="{Binding Glyph}"
                                                                                   FontFamily="{StaticResource IconFont}" FontSize="11"
                                                                                   Margin="0,2,0,0" Foreground="{DynamicResource WarningBrush}"/>
                                                                        <StackPanel Grid.Column="1">
                                                                            <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap"
                                                                                       FontFamily="{StaticResource CaptionFont}"
                                                                                       Foreground="{DynamicResource TextSecondary}"/>
                                                                            <TextBlock Text="{Binding Suggestion}" FontSize="10" TextWrapping="Wrap"
                                                                                       FontFamily="{StaticResource CaptionFont}" Margin="0,2,0,0"
                                                                                       Foreground="{DynamicResource TextTertiary}"
                                                                                       Visibility="{Binding Suggestion, Converter={StaticResource HasValueToVis}}"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                    <DataTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                            <Setter TargetName="SevIcon" Property="Foreground" Value="{DynamicResource NegativeBrush}"/>
                                                                        </DataTrigger>
                                                                    </DataTemplate.Triggers>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding StatusMessage}" Margin="0,16,0,0" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextTertiary}"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
