<Window x:Class="IKEMENLab.App.Views.CharacterTuningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:IKEMENLab.App.ViewModels"
        Title="Size &amp; Stats" Height="720" Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        MinHeight="480" MinWidth="520"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <DataTemplate x:Key="TuningRowTemplate" DataType="{x:Type vm:TuningRowViewModel}">
            <Grid Margin="0,0,0,6" ToolTip="{Binding HelpText}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBox Grid.Column="1" Style="{StaticResource FieldBox}"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{Binding Label}"/>
                <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Error}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource NegativeBrush}"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextTertiary}"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <Run Text="{Binding RangeText, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding DefaultHint, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,16,0,0">
            <TextBlock DockPanel.Dock="Left" Text="{Binding Status}" FontSize="12" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" MaxWidth="300"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Undo last save" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Command="{Binding UndoCommand}"
                        AutomationProperties.Name="Undo last save"
                        Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Reset" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Command="{Binding ResetCommand}"
                        AutomationProperties.Name="Reset tuning"/>
                <Button Content="Save" Style="{StaticResource PrimaryButton}" MinWidth="88"
                        Command="{Binding SaveCommand}" IsDefault="True"
                        AutomationProperties.Name="Save tuning"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}">
                    <Run Text="{Binding Title, Mode=OneWay}"/><Run Text=" &#x2014; size &amp; stats"/>
                </TextBlock>
                <TextBlock Text="{Binding Intro}" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondary}"/>

                <StackPanel Visibility="{Binding HasSnapshot, Converter={StaticResource BoolToVis}}">
                    <!-- ============ Size ============ -->
                    <TextBlock Text="Size" Margin="0,24,0,0" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,10,0,0" CornerRadius="8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Scale by" VerticalAlignment="Center" FontSize="12" Margin="0,0,12,0"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <Button Content="0.75&#215;" CommandParameter="0.75" Command="{Binding ScaleCommand}"
                                        Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                                        AutomationProperties.Name="Scale by 0.75"/>
                                <Button Content="0.9&#215;" CommandParameter="0.9" Command="{Binding ScaleCommand}"
                                        Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                                        AutomationProperties.Name="Scale by 0.9"/>
                                <Button Content="1.1&#215;" CommandParameter="1.1" Command="{Binding ScaleCommand}"
                                        Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                                        AutomationProperties.Name="Scale by 1.1"/>
                                <Button Content="1.25&#215;" CommandParameter="1.25" Command="{Binding ScaleCommand}"
                                        Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                                        AutomationProperties.Name="Scale by 1.25"/>
                                <Button Content="1.5&#215;" CommandParameter="1.5" Command="{Binding ScaleCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        AutomationProperties.Name="Scale by 1.5"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ScaleHint}" Margin="0,10,0,0" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextTertiary}"/>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding SizeRows}" Margin="0,10,0,0" Focusable="False"
                                  ItemTemplate="{StaticResource TuningRowTemplate}"/>

                    <!-- ============ Stats ============ -->
                    <TextBlock Text="Stats" Margin="0,24,0,0" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <ItemsControl ItemsSource="{Binding StatRows}" Margin="0,10,0,0" Focusable="False"
                                  ItemTemplate="{StaticResource TuningRowTemplate}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>

</Window>
