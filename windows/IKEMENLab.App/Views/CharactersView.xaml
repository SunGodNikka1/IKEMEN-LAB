<UserControl x:Class="IKEMENLab.App.Views.CharactersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:IKEMENLab.App.ViewModels"
             xmlns:views="clr-namespace:IKEMENLab.App.Views">
    <UserControl.Resources>
        <!-- "…" overflow menu shared by rows and cards (read-only actions only) -->
        <ContextMenu x:Key="RowMenu">
            <MenuItem Header="Show in Explorer"
                      Command="{Binding PlacementTarget.Tag.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"/>
            <MenuItem Header="Copy DEF path"
                      Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"/>
        </ContextMenu>

        <!-- Portrait tile with initial fallback -->
        <DataTemplate x:Key="Portrait" DataType="{x:Type vm:CharacterRowViewModel}">
            <Grid>
                <TextBlock Text="{Binding Initial}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextTertiary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Thumbnail, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}"/>
                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="InspectorColumn" Width="340"/>
        </Grid.ColumnDefinitions>

        <views:BrowserHeader Grid.ColumnSpan="2" Section="Characters"
                             SearchText="{Binding SearchText, Mode=TwoWay}"
                             ViewMode="{Binding ViewMode, Mode=TwoWay}"
                             HomeCommand="{Binding GoHomeCommand}"
                             CountText="{Binding VisibleCount, StringFormat={}{0} shown}"/>

        <!-- ================= List ================= -->
        <ListBox x:Name="CharacterList" Grid.Row="1" Style="{StaticResource BrowserListBox}"
                 ItemsSource="{Binding Characters}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource BrowserRowItem}"
                 Visibility="{Binding IsListMode, Converter={StaticResource BoolToVis}}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:CharacterRowViewModel}">
                    <Grid Height="56" Margin="16,0,16,0" Opacity="{Binding RowOpacity}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*" MinWidth="140"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="36" Height="36" CornerRadius="6" ClipToBounds="True"
                                Background="{DynamicResource SelectedBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Portrait}"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding PathText}" Style="{StaticResource MonoText}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="{Binding Author}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>

                        <Border Grid.Column="3" Style="{StaticResource Pill}" Margin="0,0,12,0"
                                Visibility="{Binding HasFeatures, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding FeaturesText}" Style="{StaticResource PillText}"/>
                        </Border>

                        <TextBlock Grid.Column="4" Text="{Binding DateText}" FontSize="12" VerticalAlignment="Center"
                                   FontFamily="{StaticResource CaptionFont}" Foreground="{DynamicResource TextTertiary}"/>

                        <Border Grid.Column="5" Background="Transparent" ToolTip="{Binding StatusToolTip}"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                            <CheckBox Style="{StaticResource StatusToggle}" IsChecked="{Binding IsActive, Mode=OneWay}"/>
                        </Border>

                        <Button Grid.Column="6" Style="{StaticResource GhostIconButton}" Content="{StaticResource Glyph.More}"
                                ToolTip="More" Click="MoreButton_Click"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ================= Grid ================= -->
        <ListBox Grid.Row="1" Style="{StaticResource BrowserListBox}" Padding="24,20,8,20"
                 ItemsSource="{Binding Characters}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource BrowserCardItem}"
                 VirtualizingPanel.IsVirtualizing="False"
                 Visibility="{Binding IsGridMode, Converter={StaticResource BoolToVis}}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:CharacterRowViewModel}">
                    <Grid Width="160" Height="196" Opacity="{Binding RowOpacity}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="140"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource SelectedBackgroundBrush}" ClipToBounds="True">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Portrait}"/>
                        </Border>
                        <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                Background="Transparent" ToolTip="{Binding StatusToolTip}">
                            <Ellipse Width="8" Height="8">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource TextDisabled}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource PositiveBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="10,8,10,0">
                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Author}" FontSize="11" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextTertiary}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Empty states -->
        <TextBlock Grid.Row="1" Text="No characters match your search." Style="{StaticResource BodyText}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}"/>
        <TextBlock Grid.Row="1" Text="No characters indexed. Choose an IKEMEN GO folder in Settings." Style="{StaticResource BodyText}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding HasNoCharacters, Converter={StaticResource BoolToVis}}"/>

        <!-- ================= Inspector ================= -->
        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1,0,0,0">
            <Grid>
                <TextBlock Text="Select a character" Style="{StaticResource BodyText}" Foreground="{DynamicResource TextTertiary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Inspector, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}"/>
                <ContentControl Content="{Binding Inspector}" Focusable="False">
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vm:CharacterInspectorViewModel}">
                            <views:CharacterInspectorView/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
