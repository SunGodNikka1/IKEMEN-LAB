<Window x:Class="IKEMENLab.App.Views.InstallPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:IKEMENLab.App.ViewModels"
        Title="Install Content" Height="520" Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        MinHeight="360" MinWidth="560"
        Background="{DynamicResource WindowBackgroundBrush}">
    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,16,0,0">
            <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}" FontSize="12"
                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="420"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        MinWidth="88" Command="{Binding CancelCommand}" IsCancel="True"/>
                <Button Content="Install" Style="{StaticResource PrimaryButton}" MinWidth="88"
                        Command="{Binding InstallCommand}" IsDefault="True"/>
            </StackPanel>
        </DockPanel>

        <StackPanel>
            <TextBlock Text="Confirm installation" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="{Binding Summary}" Margin="0,6,0,0" FontSize="12"
                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap"
                       Text="select.def and config.ini are not modified. Duplicates require Replace or Skip."/>

            <Border Margin="0,14,0,0" CornerRadius="8" Padding="10,8"
                    Background="{DynamicResource InfoBackgroundBrush}"
                    Visibility="{Binding HasFailures, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Failures}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource InfoHoverBrush}" Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Text="No installable character or stage packages were detected."
                       Margin="0,24,0,0" FontSize="13" Foreground="{DynamicResource TextTertiary}"
                       Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>

            <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" MaxHeight="320"
                          Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:InstallPreviewRowViewModel}">
                            <Border Margin="0,0,0,8" Padding="12" CornerRadius="8"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                                    Background="{DynamicResource SelectedBackgroundBrush}">
                                                <TextBlock Text="{Binding KindLabel}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                            </Border>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="Medium"
                                                       Foreground="{DynamicResource TextPrimary}"/>
                                            <Border CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                                    Background="{DynamicResource SelectedBackgroundBrush}">
                                                <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                           Foreground="{DynamicResource TextTertiary}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   Text="{Binding DefName, StringFormat=DEF: {0}}"/>
                                        <TextBlock Margin="0,2,0,0" FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   Text="{Binding Source, StringFormat=Source: {0}}"/>
                                        <TextBlock Margin="0,2,0,0" FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   Text="{Binding Target, StringFormat=Target: {0}}"/>
                                        <TextBlock Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   Text="{Binding WarningsText}"
                                                   Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                    Visibility="{Binding NeedsDecision, Converter={StaticResource BoolToVis}}">
                                            <CheckBox Content="Replace existing" IsChecked="{Binding ReplaceSelected}" Margin="0,0,16,0"/>
                                            <CheckBox Content="Skip" IsChecked="{Binding SkipSelected}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </DockPanel>
</Window>
