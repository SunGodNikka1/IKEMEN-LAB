<UserControl x:Class="IKEMENLab.App.Views.ScreenpacksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:IKEMENLab.App.ViewModels"
             xmlns:views="clr-namespace:IKEMENLab.App.Views">
    <UserControl.Resources>
        <DataTemplate x:Key="Preview" DataType="{x:Type vm:ScreenpackRowViewModel}">
            <Grid Background="{DynamicResource SelectedBackgroundBrush}">
                <TextBlock Text="{StaticResource Glyph.Screenpacks}" FontFamily="{StaticResource IconFont}" FontSize="18"
                           Foreground="{DynamicResource TextDisabled}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Preview, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}"/>
                <Image Source="{Binding Preview}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ActivePill" DataType="{x:Type vm:ScreenpackRowViewModel}">
            <Border CornerRadius="4" Padding="7,2" BorderThickness="1" HorizontalAlignment="Left"
                    Background="{DynamicResource PositiveBackgroundBrush}" BorderBrush="#4D10B981"
                    ToolTip="Motif currently set in save/config.ini"
                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{StaticResource Glyph.Check}" FontFamily="{StaticResource IconFont}" FontSize="10"
                               Foreground="{DynamicResource PositiveBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="Active" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource PositiveBrush}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <views:BrowserHeader Section="Screenpacks"
                             SearchText="{Binding SearchText, Mode=TwoWay}"
                             ViewMode="{Binding ViewMode, Mode=TwoWay}"
                             ShowSort="False"
                             HomeCommand="{Binding GoHomeCommand}"
                             CountText="{Binding VisibleCount, StringFormat={}{0} found}"/>

        <StackPanel Grid.Row="1" Margin="20,0,20,8">
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"
                       Visibility="{Binding Error, Converter={StaticResource HasValueToVis}}"/>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Visibility="{Binding StatusText, Converter={StaticResource HasValueToVis}}"/>
            <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1" Padding="0,12" Margin="0,8,0,0"
                    Visibility="{Binding IsPreviewing, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Activate screenpack — preview" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{Binding Preview.ScreenpackName}" Style="{StaticResource BodyText}" Margin="0,6,0,0"/>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap">
                        <Run Text="Current motif: "/><Run Text="{Binding Preview.CurrentMotif}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap">
                        <Run Text="New motif: "/><Run Text="{Binding Preview.NewMotif}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap">
                        <Run Text="system.def: "/><Run Text="{Binding Preview.SystemDefPath}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding PreviewWarningsText}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding PreviewWarningsText, Converter={StaticResource HasValueToVis}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Activate" Command="{Binding ConfirmActivateCommand}" Style="{StaticResource PrimaryButton}"
                                IsEnabled="{Binding CanConfirmActivate}" AutomationProperties.Name="Confirm activate screenpack"/>
                        <Button Content="Cancel" Command="{Binding CancelPreviewCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- List -->
        <ListBox Grid.Row="2" Style="{StaticResource BrowserListBox}"
                 ItemsSource="{Binding Screenpacks}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource BrowserRowItem}"
                 Visibility="{Binding IsListMode, Converter={StaticResource BoolToVis}}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ScreenpackRowViewModel}">
                    <Grid Height="104" Margin="16,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="152"/>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="84"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>

                        <Border Height="84" CornerRadius="6" ClipToBounds="True" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Preview}"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"
                                           TextTrimming="CharacterEllipsis"/>
                                <Border Style="{StaticResource Pill}" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding TypeText}" Style="{StaticResource PillText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding PathText}" Style="{StaticResource MonoText}" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding ComponentsText}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextTertiary}"/>
                            <TextBlock Text="{Binding CapacityWarning}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource WarningBrush}"
                                       Visibility="{Binding HasCapacityWarning, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ResolutionText}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                       FontFamily="{StaticResource CaptionFont}"/>
                            <TextBlock Text="localcoord" FontSize="10" Foreground="{DynamicResource TextTertiary}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SlotsText}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                       FontFamily="{StaticResource CaptionFont}"/>
                            <TextBlock Text="select screen" FontSize="10" Foreground="{DynamicResource TextTertiary}"/>
                        </StackPanel>

                        <ContentPresenter Grid.Column="4" Content="{Binding}" ContentTemplate="{StaticResource ActivePill}"
                                          VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="5" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostIconButton}" Content="&#xE8FB;"
                                    ToolTip="Activate screenpack" CommandParameter="{Binding}"
                                    IsEnabled="{Binding CanActivate}"
                                    Command="{Binding DataContext.BeginActivateCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    AutomationProperties.Name="Activate screenpack"/>
                            <Button Style="{StaticResource GhostIconButton}" Content="{StaticResource Glyph.OpenFolder}"
                                    ToolTip="Show in Explorer" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Grid -->
        <ListBox Grid.Row="2" Style="{StaticResource BrowserListBox}" Padding="24,20,8,20"
                 ItemsSource="{Binding Screenpacks}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource BrowserCardItem}" VirtualizingPanel.IsVirtualizing="False"
                 Visibility="{Binding IsGridMode, Converter={StaticResource BoolToVis}}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ScreenpackRowViewModel}">
                    <Grid Width="320" Height="220">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="140"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Preview}"/>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ActivePill}"
                                          HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"/>
                        <StackPanel Grid.Row="1" Margin="12,8,12,0">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextTertiary}" Margin="0,2,0,0">
                                <Run Text="{Binding ResolutionText, Mode=OneWay}"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding SlotsText, Mode=OneWay}"/>
                            </TextBlock>
                            <Button Content="Activate" Margin="0,6,0,0" HorizontalAlignment="Left"
                                    Style="{StaticResource SecondaryButton}"
                                    IsEnabled="{Binding CanActivate}"
                                    CommandParameter="{Binding}"
                                    Command="{Binding DataContext.BeginActivateCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    AutomationProperties.Name="Activate screenpack"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding HasNone, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="No screenpacks found in data/." Style="{StaticResource BodyText}" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
