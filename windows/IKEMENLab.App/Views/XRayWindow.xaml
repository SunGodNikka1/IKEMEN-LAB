<Window x:Class="IKEMENLab.App.Views.XRayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:IKEMENLab.App.ViewModels"
        Title="Character X-Ray" Height="860" Width="1440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        MinHeight="560" MinWidth="1040"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <!-- One row look for every lens and the details panel: confidence glyph + title + subtitle; highlighted when related to the selection. -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type vm:XRayRow}">
            <Border x:Name="Bd" Padding="10,6" Background="Transparent" ToolTip="{Binding Tooltip}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" Width="18" FontSize="13"
                               VerticalAlignment="Top" Visibility="{Binding HasConfidence, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource TextTertiary}"
                                   Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="LensPanel" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <Style x:Key="LensAtlas" TargetType="Grid" BasedOn="{StaticResource LensPanel}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveLens}" Value="Atlas">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LensTriggers" TargetType="Grid" BasedOn="{StaticResource LensPanel}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveLens}" Value="Triggers">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LensGraph" TargetType="Grid" BasedOn="{StaticResource LensPanel}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveLens}" Value="Graph">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LensVariables" TargetType="Grid" BasedOn="{StaticResource LensPanel}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveLens}" Value="Variables">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LensHelpers" TargetType="Grid" BasedOn="{StaticResource LensPanel}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveLens}" Value="Helpers">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PlaybackBanner" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Combos.Playback.ResultKind}" Value="Verified">
                    <Setter Property="Background" Value="{DynamicResource PositiveBackgroundBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Combos.Playback.ResultKind}" Value="Failed">
                    <Setter Property="Background" Value="{DynamicResource NegativeBackgroundBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Combos.Playback.ResultKind}" Value="Inconclusive">
                    <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Ability Lab banner: performed = green, not performed = red, could not test = amber, preview = neutral with an amber outline (never a pass) -->
        <Style x:Key="AbilityBanner" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Atlas.Lab.ResultKind}" Value="Verified">
                    <Setter Property="Background" Value="{DynamicResource PositiveBackgroundBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Atlas.Lab.ResultKind}" Value="Failed">
                    <Setter Property="Background" Value="{DynamicResource NegativeBackgroundBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Atlas.Lab.ResultKind}" Value="Inconclusive">
                    <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Atlas.Lab.ResultKind}" Value="Preview">
                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LensCombos" TargetType="Grid" BasedOn="{StaticResource LensPanel}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveLens}" Value="Combos">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LensTimeline" TargetType="Grid" BasedOn="{StaticResource LensPanel}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveLens}" Value="Timeline">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ Header ============ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button DockPanel.Dock="Left" Content="&#x25C0; Back" Style="{StaticResource SecondaryButton}" Margin="0,0,14,0"
                    Command="{Binding BackCommand}" VerticalAlignment="Center" AutomationProperties.Name="Back"/>
            <TextBox DockPanel.Dock="Right" Width="300" Style="{StaticResource SearchBox}" Tag="Search states, commands, variables&#x2026;"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search the index"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}">
                    <Run Text="X-Ray &#x2014; "/><Run Text="{Binding CharacterName, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- ============ Lens switcher + confidence legend ============ -->
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Legend}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiary}"/>
            <Border Style="{StaticResource SegmentedHost}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton GroupName="XRayLens" Content="Ability Atlas" Style="{StaticResource SegmentedItem}"
                                 IsChecked="{Binding ActiveLens, Converter={StaticResource EnumEquals}, ConverterParameter=Atlas}"/>
                    <RadioButton GroupName="XRayLens" Content="Triggers" Style="{StaticResource SegmentedItem}"
                                 IsChecked="{Binding ActiveLens, Converter={StaticResource EnumEquals}, ConverterParameter=Triggers}"/>
                    <RadioButton GroupName="XRayLens" Content="State Graph" Style="{StaticResource SegmentedItem}"
                                 IsChecked="{Binding ActiveLens, Converter={StaticResource EnumEquals}, ConverterParameter=Graph}"/>
                    <RadioButton GroupName="XRayLens" Content="Variables" Style="{StaticResource SegmentedItem}"
                                 IsChecked="{Binding ActiveLens, Converter={StaticResource EnumEquals}, ConverterParameter=Variables}"/>
                    <RadioButton GroupName="XRayLens" Content="Helpers" Style="{StaticResource SegmentedItem}"
                                 IsChecked="{Binding ActiveLens, Converter={StaticResource EnumEquals}, ConverterParameter=Helpers}"/>
                    <RadioButton GroupName="XRayLens" Content="Animation &amp; CLSN" Style="{StaticResource SegmentedItem}"
                                 IsChecked="{Binding ActiveLens, Converter={StaticResource EnumEquals}, ConverterParameter=Timeline}"/>
                    <RadioButton GroupName="XRayLens" Content="Combos" Style="{StaticResource SegmentedItem}"
                                 IsChecked="{Binding ActiveLens, Converter={StaticResource EnumEquals}, ConverterParameter=Combos}"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- ============ Lenses ============ -->
            <Border Grid.Column="0" Style="{StaticResource Card}" CornerRadius="10" Padding="0">
                <Grid>
                    <!-- 1. Ability Atlas -->
                    <Grid x:Name="LensAtlasPanel" Style="{StaticResource LensAtlas}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Margin="14,12,14,4" Text="{Binding Atlas.Summary}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                        <ListBox Grid.Row="1" Style="{StaticResource BrowserListBox}" ItemContainerStyle="{StaticResource BrowserRowItem}"
                                 ItemsSource="{Binding Atlas.View}" SelectedItem="{Binding Atlas.SelectedRow, Mode=TwoWay}"
                                 ItemTemplate="{StaticResource RowTemplate}" AutomationProperties.Name="Abilities">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="14,16,0,4">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="   &#x25D0; category is inferred" FontSize="11" Foreground="{DynamicResource WarningBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                        </ListBox>

                        <!-- Phase 2: Ability Lab. Play Ability performs the selected ability through its own command; Preview State forces its entry state (never proof). -->
                        <Border Grid.Row="2" x:Name="AbilityLabBar" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSubtle}" Padding="14,10,14,10">
                            <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding Atlas.Lab.AbilityTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Atlas.Lab.PathText}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"
                                               AutomationProperties.Name="Play Ability path"/>
                                    <TextBlock Text="{Binding Atlas.Lab.PathWarnings}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"
                                               Visibility="{Binding Atlas.Lab.HasPathWarnings, Converter={StaticResource BoolToVis}}"/>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Content="▶ Play Ability" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6" Command="{Binding Atlas.Lab.PlayAbilityCommand}"
                                                AutomationProperties.Name="Play the selected ability in IKEMEN"
                                                ToolTip="Performs the ability from neutral through its own command in a disposable sandbox match, and reports whether it started and what followed."/>
                                        <Button Content="Preview State (not proof)" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" Command="{Binding Atlas.Lab.PreviewStateCommand}"
                                                AutomationProperties.Name="Preview the entry state (not proof)"
                                                ToolTip="Forces the ability's entry state with the engine's changeState for a look. It skips the command and every condition, so it never shows the move can be performed and is never counted as a result."/>
                                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" Command="{Binding Atlas.Lab.CancelCommand}"
                                                Visibility="{Binding Atlas.Lab.IsBusy, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Cancel ability playback"/>
                                        <Button Content="Replay" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" Command="{Binding Atlas.Lab.ReplayCommand}"
                                                AutomationProperties.Name="Replay the last ability run"/>
                                        <Button Content="Inspect Failure" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" Command="{Binding Atlas.Lab.InspectFailureCommand}"
                                                Visibility="{Binding Atlas.Lab.CanInspect, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Inspect why the ability was not performed"/>
                                        <Button Content="View Trace" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" Command="{Binding Atlas.Lab.ViewTraceCommand}"
                                                Visibility="{Binding Atlas.Lab.HasResult, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="View the ability run's trace"/>
                                        <Button Content="Copy Full Diagnostic" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" Command="{Binding Atlas.Lab.CopyDiagnosticCommand}"
                                                AutomationProperties.Name="Copy the full diagnostic for the last ability attempt"/>
                                        <Button Content="Playback setup" Style="{StaticResource SecondaryButton}" Margin="0,0,0,6" Command="{Binding Atlas.Lab.OpenSetupCommand}"
                                                AutomationProperties.Name="Open playback setup in the Combos lens" ToolTip="The engine, dummy, stage and approach distance are shared with Play Combo."/>
                                    </WrapPanel>
                                    <Border Style="{StaticResource AbilityBanner}" Margin="0,0,0,6" Visibility="{Binding Atlas.Lab.HasStatus, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" AutomationProperties.Name="Ability playback result">
                                                <Run Text="{Binding Atlas.Lab.ResultGlyph, Mode=OneWay}" FontWeight="Bold"/><Run Text="  "/><Run Text="{Binding Atlas.Lab.Headline, Mode=OneWay}"/>
                                            </TextBlock>
                                            <ItemsControl ItemsSource="{Binding Atlas.Lab.ResultLines}" Focusable="False" Margin="0,4,0,0"
                                                          Visibility="{Binding Atlas.Lab.HasResultLines, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" Margin="0,1,0,0" Foreground="{DynamicResource TextSecondary}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource AbilityBanner}" Margin="0,0,0,6" Visibility="{Binding Atlas.Lab.ShowFailure, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Atlas.Lab.FailureWhy}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="{Binding Atlas.Lab.FailureHints}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextSecondary}"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding Atlas.Lab.SetupSummary}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiary}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- 2. Trigger Explorer -->
                    <Grid x:Name="LensTriggersPanel" Style="{StaticResource LensTriggers}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ListBox Grid.Column="0" Style="{StaticResource BrowserListBox}" ItemContainerStyle="{StaticResource BrowserRowItem}"
                                 ItemsSource="{Binding Triggers.Controllers}" SelectedItem="{Binding Triggers.SelectedController, Mode=TwoWay}"
                                 ItemTemplate="{StaticResource RowTemplate}" AutomationProperties.Name="Controllers"/>
                        <DockPanel Grid.Column="1" Margin="14,12,14,12">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding Triggers.Header}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock DockPanel.Dock="Top" Margin="0,4,0,8" Text="Double-click an outcome to jump to it. Select a line to see its source." FontSize="11"
                                       Foreground="{DynamicResource TextTertiary}"/>
                            <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Text="{Binding Triggers.Facets}" FontSize="11" Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap"/>
                            <TreeView x:Name="GateTree" ItemsSource="{Binding Triggers.Nodes}" Background="Transparent" BorderThickness="0"
                                      Foreground="{DynamicResource TextPrimary}" SelectedItemChanged="OnGateSelected" MouseDoubleClick="OnGateDoubleClick"
                                      AutomationProperties.Name="Trigger structure">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="True"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type vm:GateNode}" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <TextBlock Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" Width="18" FontSize="13"
                                                       Visibility="{Binding HasGlyph, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontFamily="{StaticResource MonoFont}"/>
                                            <TextBlock Text="{Binding Detail}" Margin="12,0,0,0" FontSize="11" Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"
                                                       Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </DockPanel>
                    </Grid>

                    <!-- 3. State Graph -->
                    <Grid x:Name="LensGraphPanel" Style="{StaticResource LensGraph}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="14,12,14,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock Text="Depth" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0"/>
                                <Slider Style="{StaticResource FlatSlider}" Width="110" Minimum="1" Maximum="3" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding Graph.Depth}" VerticalAlignment="Center" AutomationProperties.Name="Graph depth"/>
                                <TextBlock Text="{Binding Graph.DepthText}" FontSize="12" Margin="8,0,0,0" MinWidth="44" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Graph.Caption}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                        </DockPanel>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Grid Width="{Binding Graph.CanvasWidth}" Height="{Binding Graph.CanvasHeight}">
                                <ItemsControl ItemsSource="{Binding Graph.Edges}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:GraphEdgeVM}">
                                            <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="{Binding Stroke}"
                                                  StrokeThickness="{Binding Thickness}" StrokeDashArray="{Binding Dash}" StrokeEndLineCap="Triangle" ToolTip="{Binding Tooltip}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding Graph.Edges}" Focusable="False" IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding MidX}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding MidY}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:GraphEdgeVM}">
                                            <TextBlock Text="{Binding MidGlyph}" Foreground="{Binding MidBrush}" FontSize="14" FontWeight="Bold"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding Graph.Nodes}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:GraphNodeVM}">
                                            <Border x:Name="Node" Width="176" Height="44" CornerRadius="8" Padding="8,3" Cursor="Hand"
                                                    Background="{DynamicResource CardSolidBrush}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                                    ToolTip="{Binding Id}" MouseLeftButtonUp="OnNodeClicked">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" Width="16" FontSize="12" VerticalAlignment="Center"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}"/>
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextTertiary}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                    <Setter TargetName="Node" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCenter}" Value="True">
                                                    <Setter TargetName="Node" Property="BorderBrush" Value="{DynamicResource InfoBrush}"/>
                                                    <Setter TargetName="Node" Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <!-- 4. Variable Map -->
                    <Grid x:Name="LensVariablesPanel" Style="{StaticResource LensVariables}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0">
                            <TextBox DockPanel.Dock="Top" Style="{StaticResource FieldBox}" Margin="12,12,12,8"
                                     Text="{Binding Variables.Filter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter by name, count or inferred label"
                                     AutomationProperties.Name="Filter variables"/>
                            <ListBox Style="{StaticResource BrowserListBox}" ItemContainerStyle="{StaticResource BrowserRowItem}"
                                     ItemsSource="{Binding Variables.View}" SelectedItem="{Binding Variables.SelectedRow, Mode=TwoWay}"
                                     ItemTemplate="{StaticResource RowTemplate}" AutomationProperties.Name="Variables"/>
                        </DockPanel>
                        <DockPanel Grid.Column="1" Margin="14,12,14,12">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding Variables.UsesHeader}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock DockPanel.Dock="Top" Margin="0,4,0,8" Text="{Binding Variables.Traits}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"/>
                            <ListBox Style="{StaticResource BrowserListBox}" ItemContainerStyle="{StaticResource BrowserRowItem}"
                                     ItemsSource="{Binding Variables.Uses}" SelectedItem="{Binding Variables.SelectedUse, Mode=TwoWay}"
                                     ItemTemplate="{StaticResource RowTemplate}" AutomationProperties.Name="Uses"/>
                        </DockPanel>
                    </Grid>

                    <!-- 5. Helper Tree -->
                    <Grid x:Name="LensHelpersPanel" Style="{StaticResource LensHelpers}">
                        <DockPanel Margin="14,12,14,12">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding Helpers.Summary}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                            <TreeView ItemsSource="{Binding Helpers.Roots}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}"
                                      SelectedItemChanged="OnHelperSelected" AutomationProperties.Name="Helper family">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type vm:TreeNodeVM}" ItemsSource="{Binding Children}">
                                        <Border x:Name="Bd" Padding="4,3" Background="Transparent">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" Width="18" FontSize="13"
                                                           Visibility="{Binding HasGlyph, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="{Binding Title}" FontSize="13"/>
                                                <TextBlock Text="{Binding Subtitle}" Margin="12,0,0,0" FontSize="11" Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"
                                                           Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </Border>
                                        <HierarchicalDataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                            </DataTrigger>
                                        </HierarchicalDataTemplate.Triggers>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </DockPanel>
                    </Grid>

                    <!-- 6. Animation / CLSN timeline -->
                    <Grid x:Name="LensTimelinePanel" Style="{StaticResource LensTimeline}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="14,12,14,4">
                            <TextBlock Text="{Binding Timeline.Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{Binding Timeline.Detail}" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="14,4,14,4">
                            <ListBox ItemsSource="{Binding Timeline.Frames}" SelectedItem="{Binding Timeline.SelectedFrame, Mode=TwoWay}" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     ItemContainerStyle="{StaticResource BrowserCardItem}" AutomationProperties.Name="Animation frames">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FrameVM}">
                                        <StackPanel Width="{Binding Width}" Margin="8,6">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding SpriteGlyph}" Foreground="{Binding SpriteBrush}" FontSize="12"/>
                                                <TextBlock Text="{Binding Label}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding TicksText}" FontSize="11" Foreground="{DynamicResource TextTertiary}"/>
                                            <ItemsControl ItemsSource="{Binding Markers}" Focusable="False" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:MarkerVM}">
                                                        <TextBlock FontSize="10" ToolTip="{Binding Tooltip}" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding Glyph, Mode=OneWay}" Foreground="{Binding Brush, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Text, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="14,4,14,12">
                            <Border Width="460" Height="340" CornerRadius="8" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Background="{DynamicResource CardSolidBrush}" ClipToBounds="True">
                                <Canvas Width="460" Height="340">
                                    <Rectangle Canvas.Left="0" Canvas.Top="290" Width="460" Height="1" Fill="#66FFFFFF"/>
                                    <Rectangle Canvas.Left="230" Canvas.Top="0" Width="1" Height="340" Fill="#66FFFFFF"/>
                                    <ItemsControl ItemsSource="{Binding Timeline.Boxes}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ClsnBoxVM}">
                                                <Rectangle Width="{Binding Width}" Height="{Binding Height}" Stroke="{Binding Stroke}" Fill="{Binding Fill}" StrokeThickness="1.5" ToolTip="{Binding Tooltip}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                            </Border>
                            <StackPanel Margin="16,0,0,0" MaxWidth="300">
                                <TextBlock Text="Collision boxes" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Margin="0,4,0,10" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"
                                           Text="Red = Clsn1 (attack), blue = Clsn2 (hurt). Crosshair = the sprite's origin, so boxes are shown exactly where the file puts them. Boxes inherited from Clsn Default say so in their tooltip."/>
                                <Button Content="Open this sprite in the Sprite Inspector&#x2026;" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                        Command="{Binding Timeline.OpenSpriteCommand}"
                                        AutomationProperties.Name="Open sprite in the Sprite Inspector"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <!-- 7. Combo candidates (Milestone 2): candidates only, never verified combos -->
                    <Grid x:Name="LensCombosPanel" Style="{StaticResource LensCombos}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Margin="14,12,14,2" Text="{Binding Combos.Caption}" FontSize="13" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock DockPanel.Dock="Top" Margin="14,0,14,8" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiary}"
                                       Text="Each row is an edge the files allow, with the confidence of what it depends on. Hover for the rules, notes and conditions the index could not model."/>
                            <ListBox Style="{StaticResource BrowserListBox}" ItemContainerStyle="{StaticResource BrowserRowItem}"
                                     ItemsSource="{Binding Combos.Edges}" SelectedItem="{Binding Combos.SelectedEdge, Mode=TwoWay}"
                                     ItemTemplate="{StaticResource RowTemplate}" AutomationProperties.Name="Candidate edges"/>
                        </DockPanel>
                        <Grid Grid.Column="1" Margin="14,12,14,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <TextBlock Text="Moves" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0"/>
                                <Slider Style="{StaticResource FlatSlider}" Width="90" Minimum="1" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding Combos.MaxMoves}" VerticalAlignment="Center" AutomationProperties.Name="Most moves in a route"/>
                                <TextBlock Text="{Binding Combos.MaxMovesText}" FontSize="12" MinWidth="52" Margin="8,0,14,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="Meter" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0"/>
                                <TextBox Style="{StaticResource FieldBox}" Width="72" Text="{Binding Combos.MeterText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Starting power. Meter gained from hits is not modelled." AutomationProperties.Name="Starting meter"/>
                                <Button Content="Find routes" Style="{StaticResource PrimaryButton}" Margin="14,0,0,0" Command="{Binding Combos.FindRoutesCommand}"
                                        AutomationProperties.Name="Find candidate routes"/>
                            </StackPanel>
                            <WrapPanel Grid.Row="1" Margin="0,8,0,4">
                                <CheckBox Content="Hit-confirm cancels only" IsChecked="{Binding Combos.HitConfirmOnly}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,16,4"/>
                                <CheckBox Content="Allow links through neutral" IsChecked="{Binding Combos.AllowLinks}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,16,4"
                                          ToolTip="Timing is not modelled, so these routes are much weaker."/>
                                <CheckBox Content="Start from the selected state" IsChecked="{Binding Combos.FromSelected}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            </WrapPanel>
                            <DockPanel Grid.Row="2">
                                <TextBlock DockPanel.Dock="Top" Text="{Binding Combos.RouteStatus}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" Foreground="{DynamicResource TextTertiary}"/>
                                <ListBox Style="{StaticResource BrowserListBox}" ItemContainerStyle="{StaticResource BrowserRowItem}"
                                         ItemsSource="{Binding Combos.Routes}" SelectedItem="{Binding Combos.SelectedRoute, Mode=TwoWay}"
                                         ItemTemplate="{StaticResource RowTemplate}" AutomationProperties.Name="Candidate routes"/>
                            </DockPanel>
                            <!-- Milestone 4: play the selected candidate route in a disposable IKEMEN match and bring the verdict back here -->
                            <StackPanel Grid.Row="3" Margin="0,8,0,0" x:Name="PlaybackBar">
                                <WrapPanel>
                                    <Button Content="▶ Play Combo" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6" Command="{Binding Combos.Playback.PlayCommand}"
                                            AutomationProperties.Name="Play the selected combo in IKEMEN" ToolTip="Plays the selected candidate route in a disposable sandbox match and reports Verified, Failed or Inconclusive."/>
                                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" Command="{Binding Combos.Playback.CancelCommand}"
                                            Visibility="{Binding Combos.Playback.IsBusy, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Cancel playback"/>
                                    <Button Content="Replay" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" Command="{Binding Combos.Playback.ReplayCommand}"
                                            AutomationProperties.Name="Replay the last combo"/>
                                    <Button Content="Inspect Failure" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" Command="{Binding Combos.Playback.InspectFailureCommand}"
                                            Visibility="{Binding Combos.Playback.CanInspect, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Inspect why the combo failed"/>
                                    <Button Content="View Trace" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" Command="{Binding Combos.Playback.ViewTraceCommand}"
                                            Visibility="{Binding Combos.Playback.HasResult, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="View the recorded trace"/>
                                    <Button Content="Copy Full Diagnostic" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" Command="{Binding Combos.Playback.CopyDiagnosticCommand}"
                                            AutomationProperties.Name="Copy the full diagnostic for the last attempt" ToolTip="Copies a snapshot of the last attempt: route, expected controller, what the trace showed, engine and setup."/>
                                    <Button Content="Playback setup" Style="{StaticResource SecondaryButton}" Margin="0,0,0,6" Command="{Binding Combos.Playback.ToggleSetupCommand}"
                                            AutomationProperties.Name="Playback setup"/>
                                </WrapPanel>
                                <Border Style="{StaticResource PlaybackBanner}" Margin="0,0,0,6"
                                        Visibility="{Binding Combos.Playback.HasStatus, Converter={StaticResource BoolToVis}}">
                                    <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" AutomationProperties.Name="Playback result">
                                        <Run Text="{Binding Combos.Playback.ResultGlyph, Mode=OneWay}" FontWeight="Bold"/><Run Text="  "/><Run Text="{Binding Combos.Playback.Headline, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                                <Border Style="{StaticResource PlaybackBanner}" Margin="0,0,0,6"
                                        Visibility="{Binding Combos.Playback.ShowFailure, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Combos.Playback.FailureWhy}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding Combos.Playback.FailureHints}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Visibility="{Binding Combos.Playback.ShowSetup, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Combos.Playback.SetupSummary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{DynamicResource TextTertiary}"/>
                                    <TextBlock Text="X-Ray engine (the installed engine cannot receive scripted input)" Style="{StaticResource SectionLabel}"/>
                                    <DockPanel Margin="0,2,0,6">
                                        <Button DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Command="{Binding Combos.Playback.BrowseEngineCommand}"
                                                AutomationProperties.Name="Browse for the X-Ray engine"/>
                                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding Combos.Playback.EnginePath, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="X-Ray engine path"/>
                                    </DockPanel>
                                    <TextBlock Text="Engine runtime DLLs (folder; blank = the DLLs beside the engine)" Style="{StaticResource SectionLabel}"/>
                                    <DockPanel Margin="0,2,0,6">
                                        <Button DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Command="{Binding Combos.Playback.BrowseDllsCommand}"
                                                AutomationProperties.Name="Browse for the engine runtime DLL folder"/>
                                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding Combos.Playback.EngineDlls, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Engine runtime DLL folder"/>
                                    </DockPanel>
                                    <TextBlock Text="Approach distance (blank = 60; how close P1 walks before the route starts — a threshold, not the attack's range)" Style="{StaticResource SectionLabel}"/>
                                    <TextBox Style="{StaticResource FieldBox}" Width="120" HorizontalAlignment="Left" Margin="0,2,0,2" Text="{Binding Combos.Playback.ApproachDistance, UpdateSourceTrigger=LostFocus}"
                                             AutomationProperties.Name="Approach distance"/>
                                    <TextBlock AutomationProperties.Name="Approach distance error" Text="{Binding Combos.Playback.ApproachDistanceError}" FontSize="11" Foreground="{DynamicResource NegativeBrush}" TextWrapping="Wrap" Margin="0,0,0,6"
                                               Visibility="{Binding Combos.Playback.HasApproachDistanceError, Converter={StaticResource BoolToVis}}"/>
                                    <WrapPanel>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="Dummy character (chars/ folder, blank = automatic)" Style="{StaticResource SectionLabel}"/>
                                            <TextBox Style="{StaticResource FieldBox}" Width="200" Text="{Binding Combos.Playback.Dummy, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Dummy character"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Stage (e.g. stages/kfm.def, blank = automatic)" Style="{StaticResource SectionLabel}"/>
                                            <TextBox Style="{StaticResource FieldBox}" Width="200" Text="{Binding Combos.Playback.Stage, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Stage"/>
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                            <DockPanel Grid.Row="4" Margin="0,8,0,0">
                                <TextBlock DockPanel.Dock="Top" Text="Steps of the selected route" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                                <ListBox Style="{StaticResource BrowserListBox}" ItemContainerStyle="{StaticResource BrowserRowItem}"
                                         ItemsSource="{Binding Combos.RouteSteps}" SelectedItem="{Binding Combos.SelectedStep, Mode=TwoWay}"
                                         ItemTemplate="{StaticResource RowTemplate}" AutomationProperties.Name="Route steps"/>
                            </DockPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- ============ Details / evidence / source (shared by every lens) ============ -->
            <Border Grid.Column="2" Style="{StaticResource Card}" CornerRadius="10" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="230"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14,12,14,8">
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding KindText}" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text="{Binding IdText}" Style="{StaticResource MonoText}" Margin="0,2,0,0"/>
                            <ItemsControl ItemsSource="{Binding Labels}" Margin="0,8,0,0" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:LabelChip}">
                                        <Border CornerRadius="10" Padding="8,2" Margin="0,0,6,6" BorderBrush="{Binding Brush}" BorderThickness="1" ToolTip="{Binding Tooltip}">
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextPrimary}">
                                                <Run Text="{Binding Glyph, Mode=OneWay}" Foreground="{Binding Brush, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Text, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Copy id" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,4,0,8"
                                    Command="{Binding CopyIdCommand}" AutomationProperties.Name="Copy object id"/>

                            <!-- Your name for the selected object (stored by IKEMEN Lab, never in the character files) -->
                            <StackPanel Margin="0,0,0,10" Visibility="{Binding CanRenameSelected, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding NameInfo}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                <DockPanel Margin="0,4,0,0">
                                    <Button DockPanel.Dock="Right" Content="Reset" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0"
                                            Command="{Binding ResetNameCommand}" AutomationProperties.Name="Reset to X-Ray name"
                                            ToolTip="Remove your name; X-Ray's own name shows again"/>
                                    <Button DockPanel.Dock="Right" Content="Rename" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0"
                                            Command="{Binding RenameCommand}" AutomationProperties.Name="Save name"/>
                                    <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" VerticalContentAlignment="Center"
                                             AutomationProperties.Name="Name for the selected object" ToolTip="Your name for this state / ability / command (e.g. Revolver Shot)"/>
                                </DockPanel>
                                <TextBlock Text="{Binding NameError}" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                                           Visibility="{Binding HasNameError, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>

                            <!-- Saved names whose object changed or vanished: never applied until the user decides -->
                            <Border Margin="0,0,0,10" Padding="8" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource WarningBrush}"
                                    Visibility="{Binding HasNameReview, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding NameReviewHeader}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                                    <ItemsControl ItemsSource="{Binding NameReview}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:NameReviewRow}">
                                                <StackPanel Margin="0,6,0,0">
                                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap">
                                                        <Run Text="“" /><Run Text="{Binding Label, Mode=OneWay}"/><Run Text="”  "/><Run Text="{Binding Status, Mode=OneWay}" Foreground="{DynamicResource TextSecondary}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Suggestions}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                                               Visibility="{Binding HasSuggestions, Converter={StaticResource BoolToVis}}"/>
                                                    <WrapPanel Margin="0,3,0,0">
                                                        <Button Content="Keep on changed object" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                                                                Visibility="{Binding CanKeep, Converter={StaticResource BoolToVis}}"
                                                                Command="{Binding DataContext.KeepNameCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        <Button Content="Move to selected" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                                                                ToolTip="Give this name to the object selected now"
                                                                Command="{Binding DataContext.AttachNameCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        <Button Content="Discard" Style="{StaticResource SecondaryButton}"
                                                                Command="{Binding DataContext.DiscardNameCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Sections}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DetailSection}">
                                        <StackPanel Margin="0,10,0,0">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionLabel}" Margin="0,0,0,2"/>
                                            <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:XRayRow}">
                                                        <Button Style="{StaticResource RowButton}" ContentTemplate="{StaticResource RowTemplate}" Content="{Binding}"
                                                                Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Id}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <DockPanel Grid.Row="1" Margin="14,4,14,4">
                        <Button DockPanel.Dock="Right" Content="Open file" Style="{StaticResource SecondaryButton}" Command="{Binding OpenFileCommand}"
                                AutomationProperties.Name="Open the source file"/>
                        <TextBlock Text="{Binding SourceText}" Style="{StaticResource MonoText}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ListBox Grid.Row="2" ItemsSource="{Binding SourceLines}" Background="#33000000" BorderThickness="0" Margin="8,0,8,8"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Source">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Focusable" Value="False"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SourceLine}">
                                <Grid x:Name="Line">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Number}" HorizontalAlignment="Right" Margin="0,0,8,0" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource TextTertiary}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Text}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource TextSecondary}" xml:space="preserve"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding InSpan}" Value="True">
                                        <Setter TargetName="Line" Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Search results float over the lenses -->
            <Border Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Top" Width="340" MaxHeight="360" Margin="0,4,8,0" CornerRadius="8" Panel.ZIndex="10"
                    Background="{DynamicResource CardSolidBrush}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                    Visibility="{Binding HasSearchResults, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SearchResults}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:XRayRow}">
                                <Button Style="{StaticResource RowButton}" ContentTemplate="{StaticResource RowTemplate}" Content="{Binding}"
                                        Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Id}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
