<UserControl x:Class="IKEMENLab.App.Views.CharacterInspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:IKEMENLab.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <!-- ============ Hero ============ -->
            <Grid Height="200" ClipToBounds="True" Background="{DynamicResource CardSolidBrush}">
                <Image Source="{Binding Portrait}" Stretch="UniformToFill" VerticalAlignment="Top" Opacity="0.55"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#000C0C0E" Offset="0"/>
                            <GradientStop Color="#CC0C0C0E" Offset="0.55"/>
                            <GradientStop Color="#FF0C0C0E" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <!-- Sharp portrait on the right, like a character card -->
                <Border Width="120" Height="120" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0"
                        CornerRadius="10" ClipToBounds="True" BorderBrush="{DynamicResource BorderHover}" BorderThickness="1"
                        Background="{DynamicResource SelectedBackgroundBrush}"
                        Visibility="{Binding Portrait, Converter={StaticResource HasValueToVis}}">
                    <Image Source="{Binding Portrait}" Stretch="UniformToFill" VerticalAlignment="Top"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel VerticalAlignment="Bottom" Margin="24,0,24,20">
                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource HeaderFont}" FontWeight="SemiBold" FontSize="24"
                               Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border CornerRadius="4" Padding="8,2" Background="#80181818" BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding EngineLabel}" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </Border>
                        <TextBlock Text="{Binding UpdatedText}" Margin="8,0,0,0" FontFamily="{StaticResource CaptionFont}"
                                   FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <StackPanel Margin="24,20,24,24">
                <!-- ============ Primary DEF ============ -->
                <Border Style="{StaticResource Card}" Padding="12" CornerRadius="8" Margin="0,0,0,16"
                        Visibility="{Binding ShowDefPicker, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="PRIMARY DEF" FontSize="10" FontWeight="Medium"
                                   Foreground="{DynamicResource TextTertiary}"/>
                        <ComboBox Margin="0,8,0,0" ItemsSource="{Binding DefFileChoices}"
                                  SelectedItem="{Binding SelectedDef, Mode=TwoWay}"
                                  AutomationProperties.Name="Primary DEF"/>
                        <TextBlock Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Text="{Binding DefChoiceHint}"/>
                    </StackPanel>
                </Border>

                <!-- ============ Author / Version ============ -->
                <UniformGrid Columns="2" Margin="-6,0">
                    <Border Style="{StaticResource Card}" Padding="12" Margin="6,0" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="AUTHOR" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource TextTertiary}"/>
                            <TextBlock Text="{Binding Author}" FontSize="14" FontWeight="Medium" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Author}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="12" Margin="6,0" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="VERSION" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource TextTertiary}"/>
                            <TextBlock Text="{Binding VersionText}" FontSize="14" FontWeight="Medium" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- ============ Tools ============ -->
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0"
                            Visibility="{Binding CanShowTools, Converter={StaticResource BoolToVis}}">
                    <Button Content="Inspect Sprites&#x2026;" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding OpenSpritesCommand}" CommandParameter="{Binding Row}"
                            AutomationProperties.Name="Inspect Sprites"/>
                    <Button Content="Edit Size &amp; Stats&#x2026;" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding OpenTuningCommand}" CommandParameter="{Binding Row}"
                            AutomationProperties.Name="Edit Size and Stats"/>
                    <Button Content="X-Ray&#x2026;" Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenXRayCommand}" CommandParameter="{Binding Row}"
                            ToolTip="Abilities, triggers, state graph, variables, helpers and animations of this character"
                            AutomationProperties.Name="Open Character X-Ray"/>
                </StackPanel>

                <!-- ============ Attributes ============ -->
                <DockPanel Margin="0,28,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatsNote}" FontSize="10" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextTertiary}"/>
                    <TextBlock Text="Attributes" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Attributes}" Margin="0,14,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AttributeRow}">
                            <Grid Height="20" Margin="0,0,0,10" ToolTip="{Binding ToolTip}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="52"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" FontFamily="{StaticResource CaptionFont}" FontSize="12"
                                           Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"/>
                                <Grid Grid.Column="1" Height="6" Margin="8,0,12,0" VerticalAlignment="Center">
                                    <Border CornerRadius="3" Background="{DynamicResource StatTrackBrush}"/>
                                    <Border CornerRadius="3" Background="{Binding Fill}" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding Fraction}"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="12" Foreground="{DynamicResource TextPrimary}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ============ Palettes ============ -->
                <TextBlock Text="{Binding PaletteHeader}" FontSize="12" FontWeight="SemiBold" Margin="0,18,0,0"
                           Foreground="{DynamicResource TextPrimary}"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <ItemsControl ItemsSource="{Binding Palettes}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PaletteSwatch}">
                                <Ellipse Width="24" Height="24" Margin="0,0,8,0" Fill="{Binding Fill}"
                                         Stroke="{DynamicResource BorderHover}" StrokeThickness="1" ToolTip="{Binding ToolTip}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource SelectedBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                            Visibility="{Binding MorePalettesText, Converter={StaticResource HasValueToVis}}">
                        <TextBlock Text="{Binding MorePalettesText}" FontSize="9" FontWeight="Medium"
                                   Foreground="{DynamicResource TextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="No selectable palettes defined" FontSize="11" Foreground="{DynamicResource TextTertiary}"
                           Visibility="{Binding HasPalettes, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>

                <!-- ============ Move list ============ -->
                <TextBlock Text="Move List" FontSize="12" FontWeight="SemiBold" Margin="0,28,0,0"
                           Foreground="{DynamicResource TextPrimary}"/>
                <ItemsControl ItemsSource="{Binding Moves}" Margin="0,10,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MoveRow}">
                            <StackPanel Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <Border Style="{StaticResource Pill}" Margin="8,0,0,0" Padding="5,0"
                                            Background="{DynamicResource InfoBackgroundBrush}"
                                            Visibility="{Binding IsHyper, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="HYPER" Style="{StaticResource PillText}" FontSize="9"
                                                   Foreground="{DynamicResource InfoBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Notation}" FontFamily="Segoe UI Symbol, Segoe UI" FontSize="13" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding MoreMovesText}" FontSize="11" Foreground="{DynamicResource TextTertiary}"
                           Visibility="{Binding MoreMovesText, Converter={StaticResource HasValueToVis}}"/>
                <TextBlock Text="No special moves found" FontSize="12" Foreground="{DynamicResource TextTertiary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasMoves}" Value="False"/>
                                        <Condition Binding="{Binding IsLoading}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- ============ Definition file ============ -->
                <DockPanel Margin="0,28,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding DefFileName}" FontFamily="{StaticResource MonoFont}"
                               FontSize="10" Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"/>
                    <TextBlock Text="Definition File" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                </DockPanel>
                <Border Style="{StaticResource Card}" Padding="12" Margin="0,12,0,0" CornerRadius="8" MaxHeight="260">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding DefLines}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DefLine}">
                                    <ItemsControl ItemsSource="{Binding Segments}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:DefSegment}">
                                                <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                           xml:space="preserve"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- ============ Delete ============ -->
                <Border Margin="0,28,0,0" Padding="0,16,0,0" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0"
                        Visibility="{Binding CanShowDelete, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Button Style="{StaticResource DangerButton}" HorizontalAlignment="Left"
                                Command="{Binding DeleteCommand}" CommandParameter="{Binding Row}"
                                AutomationProperties.Name="Delete Character">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource Glyph.Delete}" FontFamily="{StaticResource IconFont}"
                                           FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Delete Character…" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextTertiary}" Text="{Binding DeleteHint}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
