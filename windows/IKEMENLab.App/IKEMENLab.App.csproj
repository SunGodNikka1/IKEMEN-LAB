<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>IKEMENLab.App</RootNamespace>
    <AssemblyName>IKEMENLab</AssemblyName>
    <Product>IKEMEN Lab</Product>
    <AssemblyTitle>IKEMEN Lab</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IKEMENLab.Core\IKEMENLab.Core.csproj" />
  </ItemGroup>

  <!-- Design fonts are shared with the macOS app (single source under IKEMEN Lab/Resources/Fonts). -->
  <ItemGroup>
    <Resource Include="..\..\IKEMEN Lab\Resources\Fonts\Inter-Regular.ttf" Link="Assets\Fonts\Inter-Regular.ttf" />
    <Resource Include="..\..\IKEMEN Lab\Resources\Fonts\Manrope-Regular.ttf" Link="Assets\Fonts\Manrope-Regular.ttf" />
    <Resource Include="..\..\IKEMEN Lab\Resources\Fonts\Manrope-Medium.ttf" Link="Assets\Fonts\Manrope-Medium.ttf" />
    <Resource Include="..\..\IKEMEN Lab\Resources\Fonts\Montserrat-SemiBold.ttf" Link="Assets\Fonts\Montserrat-SemiBold.ttf" />
  </ItemGroup>

</Project>
