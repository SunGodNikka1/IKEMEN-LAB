<Project Sdk="Microsoft.NET.Sdk">

  <!-- A stand-in "engine" for the MCP tests: like Ikemen GO it reads its stdin line by line from start-up (and echoes what it read). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>stdin-engine</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
